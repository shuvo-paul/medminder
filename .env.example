APP_PORT=8080
APP_ENV=development
LOG_FILE_PATH=logs/medminder.log
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=5433
DB_USER=medminder
DB_PASSWORD=medminder
DB_NAME=medminder
DB_SSLMODE=false

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/oauth/google/callback

# Email Service (REST API microservice for sending emails)
EMAIL_SERVICE_BASE_URL=http://localhost:9000
EMAIL_FROM_ADDRESS=noreply@medminder.app
EMAIL_FROM_NAME=MedMinder
